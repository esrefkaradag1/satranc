# ── Self-hosted Supabase ─────────────────────────────────────────────────────
# REST/API URL (Kong gateway — genelde https://db.ALANADINIZ.com veya api.*)
SUPABASE_HOST=db.example.com
POSTGRES_PASSWORD=
JWT_SECRET=

VITE_SUPABASE_URL=https://db.example.com
VITE_SUPABASE_ANON_KEY=

# Admin panel yazma + veli imza API (prod)
VITE_SUPABASE_SERVICE_ROLE_KEY=

# Sunucu API (Docker / Vercel — VITE_ olmadan)
SUPABASE_URL=https://db.example.com
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=

# ── Canlı ders video (Agora) ─────────────────────────────────────────────────
VITE_AGORA_APP_ID=
VITE_AGORA_CHANNEL_PREFIX=satranc

# ── AI (opsiyonel) ───────────────────────────────────────────────────────────
VITE_OPENROUTER_API_KEY=

# ── Lichess OAuth ─────────────────────────────────────────────────────────────
VITE_LICHESS_OAUTH_CLIENT_ID=netchess-academy
LICHESS_OAUTH_CLIENT_ID=netchess-academy

# ── WhatsApp (WaMessage kişisel WP — Bearer API Key) ──────────────────────────
# Dokümantasyon: https://app.wamessage.app/apiIntegration
# Postman: https://app.wamessage.app/postman_collection_whatsapp.json
# Auth: Authorization: Bearer <API_KEY> (Api Entegrasyonu → API Key Göster)
WHATSAPP_PROVIDER=wamessage
WHATSAPP_API_BASE_URL=https://api.toplusms.app
WHATSAPP_API_KEY=
# QR sonrası gelen reg_id (POST /wp/login/qr → data.regId)
# Gönderim: POST /bulk/wp/nton (yedek: /bulk/preview/wp + /bulk/wp)
WHATSAPP_INSTANCE=
# Gönderici telefon (+905xxxxxxxxx) — QR / device check
WHATSAPP_DEVICE_PHONE=
# Otomatik antrenman bildirimlerini kapatmak için 0 yapın (varsayılan açık).
TRAINING_NOTIFY_ENABLED=1
# Gece 23:00 TR cron (/api/nightly): platform gün sonu sync + eksik WhatsApp.
# Hobby planda günde 1 cron — vercel.json zaten 20:00 UTC (= 23:00 TR) ayarlı.

# ── Vercel Cron güvenliği ────────────────────────────────────────────────────
# /api/training-notify GET tetiklerini korur. Vercel Cron bu değeri otomatik
# "Authorization: Bearer <CRON_SECRET>" başlığıyla gönderir. Rastgele uzun bir dize.
CRON_SECRET=

# ── Öğrenci API (opsiyonel) ──────────────────────────────────────────────────
# VITE_API_URL=https://api.ornek.com
